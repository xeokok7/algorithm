#include <stdio.h>
#include <string.h>

long long ext_euclid(long long a, long long b, long long *x, long long *y) {
    if (b == 0) {
        *x = 1;
        *y = 0;
        return a;
    }
    long long x1, y1;
    long long gcd = ext_euclid(b, a % b, &x1, &y1);
    *x = y1;
    *y = x1 - (a / b) * y1;
    return gcd;
}

long long mod_inverse(long long e, long long phi) {
    long long x, y;
    ext_euclid(e, phi, &x, &y);
    return (x % phi + phi) % phi;
}

// Repeated Squaring Algorithm
long long mod_exp(long long base, long long exp, long long mod) {
    long long result = 1;
    base = base % mod;
    while (exp > 0) {
        if (exp % 2 == 1) {
            result = (result * base) % mod;
        }
        base = (base * base) % mod;
        exp /= 2;
    }
    return result;
}

int char_to_num(char c) {
    if (c == ' ') return 0;
    else return c - 64;
}

int main() {
    char text[1024];
    long long p, q, e;

    scanf("%[^\n]", text);
    scanf("%lld %lld %lld", &p, &q, &e);

    int len = strlen(text);
    if (strlen(text) % 2 != 0) { // 2글자씩 묶기, 공백 포함 홀수인경우, 마지막에 공백 추가
        text[len++] = ' ';
        text[len] = '\0';
    }

    long long n = p * q;
    long long phi = (p - 1) * (q - 1);
    long long d = mod_inverse(e, phi);

    int num_blocks = len / 2;
    long long M[512]; // number
    long long C[512]; // encrypted

    for (int i = 0; i < num_blocks; i++) { // block을 숫자로 변환
        M[i] = char_to_num(text[2 * i]) * 100 + char_to_num(text[2 * i + 1]);
        C[i] = mod_exp(M[i], e, n);
    }

    //encode
    for (int i = 0; i < num_blocks; i++) { 
        printf("%lld ", M[i]);
    }
    printf("\n");

    // encrypted
    for (int i = 0; i < num_blocks; i++) {
        printf("%lld ", C[i]);
    }
    printf("\n");

    printf("%lld\n", d);

    return 0;
}
